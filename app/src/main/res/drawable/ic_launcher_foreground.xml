<?xml version="1.0" encoding="utf-8"?>
<!--
  Two stacked, softly rounded play shapes: a translucent one behind for depth and a
  white one in front, on the violet-to-magenta background. Sized to the 66dp safe zone of the 108dp adaptive canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:pivotX="56" android:pivotY="52" android:scaleX="1.1" android:scaleY="1.1">
    <!-- Back shape -->
    <path
        android:fillAlpha="0.3"
        android:fillColor="#FFFFFFFF"
        android:pathData="M33,37.2 C33,33.4 37.1,31 40.4,32.9 L63.9,46.6 C67.2,48.5 67.2,53.3 63.9,55.2 L40.4,68.9 C37.1,70.8 33,68.4 33,64.6 Z" />
    <!-- Front shape -->
    <path android:pathData="M44,39.6 C44,35.8 48.1,33.4 51.4,35.3 L74.9,49 C78.2,50.9 78.2,55.7 74.9,57.6 L51.4,71.3 C48.1,73.2 44,70.8 44,67 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="44" android:startY="34"
                android:endX="78" android:endY="72">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFFFE6F0" />
            </gradient>
        </aapt:attr>
    </path>
    </group>
</vector>
